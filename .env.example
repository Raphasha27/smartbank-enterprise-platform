# SmartBank Enterprise Platform — Environment Configuration
# Copy this file to .env and adjust values for your environment

# PostgreSQL
DB_URL=jdbc:postgresql://postgres:5432/smartbank
DB_USERNAME=smartbank
DB_PASSWORD=smartbank

# JWT
JWT_SECRET=change-this-to-a-secure-random-secret-in-production
JWT_EXPIRATION=3600000

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Service Ports
AUTH_SERVICE_PORT=8081
ACCOUNT_SERVICE_PORT=8082
TRANSACTION_SERVICE_PORT=8083
LOAN_SERVICE_PORT=8084
AUDIT_SERVICE_PORT=8085
NOTIFICATION_SERVICE_PORT=8086
LEDGER_SERVICE_PORT=8087
API_GATEWAY_PORT=8080

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

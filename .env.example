# Database
DB_URL=jdbc:postgresql://localhost:5432/smartbank
DB_USER=smartbank
DB_PASSWORD=smartbank

# Auth
JWT_SECRET=change_this_secret
JWT_EXPIRATION=86400000

# Railway overrides (set in Railway dashboard)
# DB_URL=jdbc:postgresql://${{PGHOST}}:${{PGPORT}}/${{PGDATABASE}}
# DB_USER=${{PGUSER}}
# DB_PASSWORD=${{PGPASSWORD}}
# JWT_SECRET=your-production-secret

# Deployment
APP_ENV=development
SERVER_PORT=8080
